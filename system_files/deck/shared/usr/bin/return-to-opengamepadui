#!/usr/bin/bash

# Return to OpenGamepadUI from desktop mode using the overlayfs mount approach
# Similar to return-to-gamemode but for OpenGamepadUI

IMAGE_INFO="/usr/share/ublue-os/image-info.json"
BASE_IMAGE_NAME=$(jq -r '."base-image-name"' < $IMAGE_INFO)

USER=$(id -nu 1000)
HOME=$(getent passwd $USER | cut -d: -f6)

# Enable the OpenGamepadUI session overlay if not already active
if ! systemctl is-active --quiet usr-share-wayland-sessions.mount; then
    sudo systemctl enable --now usr-share-wayland-sessions.mount
fi

# Use steamos-session-select to switch to OpenGamepadUI session
steamos-session-select opengamepadui

# Log out to return to the OpenGamepadUI session
if [[ $BASE_IMAGE_NAME = "kinoite" ]]; then
  sudo -Eu $USER qdbus org.kde.Shutdown /Shutdown org.kde.Shutdown.logout
elif [[ $BASE_IMAGE_NAME = "silverblue" ]]; then
  sudo -Eu $USER gnome-session-quit --logout --no-prompt
fi
